        {
          "id": "68e33fc7-1d42-465f-8942-564314fc4460",
          "name": "Papago NMT Translation",
          "request": {
            "name": "Papago NMT Translation",
            "description": {
              "content": "Translates text using Neural Machine Translation (NMT). Accepts source and target language codes along with the text to translate. Supports Korean, English, Japanese, Chinese (Simplified and Traditional), Vietnamese, Thai, Indonesian, French, Spanish, Russian, German, and Italian — up to 5,000 characters per request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "papago",
                "n2mt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Naver-Client-Id"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "source",
                  "value": "ko",
                  "description": "(Required) Source language code. Examples: ko (Korean), en (English), zh-CN (Chinese Simplified), zh-TW (Chinese Traditional), ja (Japanese), vi (Vietnamese), th (Thai), id (Indonesian), fr (French), es (Spanish), ru (Russian), de (German), it (Italian)"
                },
                {
                  "disabled": false,
                  "key": "target",
                  "value": "en",
                  "description": "(Required) Target language code. Same possible values as source. Must form a supported language pair."
                },
                {
                  "disabled": false,
                  "key": "text",
                  "value": "나는 한국인입니다.",
                  "description": "(Required) Text to translate. UTF-8 encoding only. Maximum 5,000 characters per request."
                },
                {
                  "disabled": false,
                  "key": "honorific",
                  "value": "false",
                  "description": "Honorific language mode for Korean output. Set to true to use honorific (formal) Korean."
                },
                {
                  "disabled": false,
                  "key": "glossaryKey",
                  "value": "<string>",
                  "description": "Glossary key to apply custom terminology during translation."
                }
              ]
            }
