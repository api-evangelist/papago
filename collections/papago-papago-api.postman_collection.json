          "name": "Korean Name Romanization",
          "request": {
            "name": "Korean Name Romanization",
            "description": {
              "content": "Converts a Korean name written in Hangul to its romanized Latin-script equivalent. Returns both the official romanization (following current Korean romanization rules) and statistically common romanizations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "krdict",
                "romanization"
